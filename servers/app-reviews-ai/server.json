{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.retracn/app-reviews-ai",
  "title": "App Store & Google Play Reviews AI (via Apify)",
  "description": "AI summary of App Store and Google Play reviews: bugs, feature requests and critical issues.",
  "version": "1.0.0",
  "websiteUrl": "https://apify.com/automationnation/app-store-review-miner",
  "repository": {
    "url": "https://github.com/retracn/app-store-google-play-reviews-ai",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://retracn.github.io/automationnation-actors/icons/app-store-review-miner.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.apify.com/?tools=automationnation/app-store-review-miner",
      "headers": [
        {
          "name": "Authorization",
          "description": "Your Apify API token, sent as 'Bearer <token>'. Get it at https://console.apify.com/settings/integrations (free account).",
          "isRequired": true,
          "isSecret": true,
          "value": "Bearer {apify_token}",
          "variables": {
            "apify_token": {
              "description": "Apify API token",
              "isRequired": true,
              "isSecret": true
            }
          }
        }
      ]
    }
  ]
}
