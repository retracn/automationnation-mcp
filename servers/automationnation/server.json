{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.retracn/automationnation",
  "title": "AutomationNation data tools (via Apify)",
  "description": "Google Shopping, Flights, Hotels, News, Images, Ads, Jobs, Trends, YouTube transcripts, leads.",
  "version": "1.1.0",
  "websiteUrl": "https://retracn.github.io/automationnation-actors/",
  "repository": {
    "url": "https://github.com/retracn/automationnation-mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://retracn.github.io/automationnation-actors/icons/google-trends-scraper.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.apify.com/?tools=automationnation/google-maps-leads,automationnation/ai-visibility-tracker,automationnation/google-trends-scraper,automationnation/google-jobs-scraper,automationnation/aeo-auditor,automationnation/uk-business-leads,automationnation/app-store-review-miner,automationnation/app-store-reviews-scraper,automationnation/google-play-reviews-scraper,automationnation/google-shopping-scraper,automationnation/google-images-scraper,automationnation/google-news-scraper,automationnation/google-videos-scraper,automationnation/youtube-transcript-scraper,automationnation/google-ads-transparency-scraper,automationnation/google-hotels-scraper,automationnation/google-flights-scraper",
      "headers": [
        {
          "name": "Authorization",
          "description": "Your Apify API token, sent as 'Bearer <token>'. Get it at https://console.apify.com/settings/integrations (free account).",
          "isRequired": true,
          "isSecret": true,
          "value": "Bearer {apify_token}",
          "variables": {
            "apify_token": {
              "description": "Apify API token",
              "isRequired": true,
              "isSecret": true
            }
          }
        }
      ]
    }
  ]
}
