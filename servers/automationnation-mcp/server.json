{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.retracn/automationnation-mcp",
  "title": "AutomationNation Data Tools",
  "description": "Agent tools: Google web search, Flights, Hotels, Shopping, News, Jobs, Trends, Maps leads, YouTube",
  "version": "1.1.1",
  "websiteUrl": "https://github.com/retracn/automationnation-mcp",
  "repository": {
    "url": "https://github.com/retracn/automationnation-mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/retracn/automationnation-mcp/main/icon.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "mcpb",
      "identifier": "https://github.com/retracn/automationnation-mcp/releases/download/v1.1.1/automationnation-mcp.mcpb",
      "version": "1.1.1",
      "fileSha256": "98bff8717e521e75f46a7531c113f8666a65dbe283ee2f52a9fd4570ea5322e7",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "APIFY_TOKEN",
          "description": "Apify API token. Runs are billed per result on this account; a free account includes monthly credit: https://console.apify.com/sign-up",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.apify.com/?tools=automationnation/data-tools-mcp-server",
      "headers": [
        {
          "name": "Authorization",
          "description": "Your Apify API token, sent as 'Bearer <token>'. Get it at https://console.apify.com/settings/integrations (free account).",
          "isRequired": true,
          "isSecret": true,
          "value": "Bearer {apify_token}",
          "variables": {
            "apify_token": {
              "description": "Apify API token",
              "isRequired": true,
              "isSecret": true
            }
          }
        }
      ]
    }
  ]
}
